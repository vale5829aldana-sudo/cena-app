    "db:reset": "prisma migrate reset --force --skip-seed && node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
