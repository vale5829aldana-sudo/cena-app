# Copia este archivo como `.env` y completa los valores.
#   cp .env.example .env

# --- Base de datos (MySQL 8 / MariaDB) -------------------------------------
# Cadena de conexión usada por Prisma (migraciones y CLI).
# Si tu contraseña tiene caracteres especiales, codifícalos para URL
# (por ejemplo: "$" -> "%24").
DATABASE_URL="mysql://usuario:contraseña@localhost:3306/eventos"

# Credenciales del driver adapter que usa la app en tiempo de ejecución.
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="usuario"
MYSQL_PASSWORD="contraseña"
MYSQL_DATABASE="eventos"

# --- Sesión ----------------------------------------------------------------
# Secreto con el que se firma la cookie del administrador.
# Genera uno propio, por ejemplo con:  openssl rand -base64 32
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
